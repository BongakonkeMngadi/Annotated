{
  "manifest_version": 3,
  "name": "Annotated AI",
  "version": "0.1.0",
  "description": "Clip web highlights and media moments into source-linked AI annotations.",
  "permissions": ["activeTab", "tabs", "scripting", "storage", "sidePanel", "identity"],
  "host_permissions": ["<all_urls>"],
  "oauth2": {
    "client_id": "__ANNOTATED_GOOGLE_OAUTH_CLIENT_ID__",
    "scopes": ["openid", "email", "profile"]
  },
  "action": {
    "default_title": "Open Annotated AI"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
